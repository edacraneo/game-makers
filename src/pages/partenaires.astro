---
import Base from '../layouts/Base.astro';
import EntryArticle from '../components/EntryArticle.astro';
import data from '../data/site.json';
const entry = (data.pages as any[]).find((p) => p.slug === 'partenaires');
---
<Base title="Nos partenaires — Game Makers" description={entry?.excerpt}>
  {entry && <EntryArticle entry={entry} basePath="/partenaires/" />}
</Base>
