---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('posts')).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  date: p.data.date,
  tags: p.data.tags || [],
  authors: p.data.authors || ['Game Makers'],
  feature: p.data.feature,
  excerpt: p.data.excerpt,
  featured: p.data.featured,
  html: p.rendered?.html || '',
})).sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const tags = [
  { name: 'Créations', slug: 'creations' },
  { name: 'Projets', slug: 'projets' },
  { name: 'Jeux', slug: 'jeux' },
  { name: 'Circuits imprimés', slug: 'pcb' },
  { name: 'Offres', slug: 'offres' },
];
---
<Base title="Projets & Créations — Game Makers" description="Galerie de toutes les créations Game Makers : consoles, bornes d'arcade, bartops et tutoriels d'impression 3D.">
  <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-28 pb-8">
    <p class="font-mono text-xs text-neon-500 uppercase tracking-[0.25em] mb-3">// Galerie</p>
    <h1 class="font-display text-4xl sm:text-5xl font-bold">Projets & <span class="text-neon-400">Créations</span></h1>
    <p class="mt-4 text-ink-400 max-w-2xl">
      {posts.length} projets documentés — chaque article détaille le matériel, la modélisation 3D,
      l'impression et l'assemblage pas à pas.
    </p>

    <div id="filters" class="mt-8 flex flex-wrap gap-2">
      <button data-filter="all" class="filter-btn font-mono text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-neon-500 bg-neon-500/10 text-neon-300 transition-colors">Tous</button>
      {tags.map((t) => (
        <button data-filter={t.slug} class="filter-btn font-mono text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-ink-700 text-ink-300 hover:border-neon-500 hover:text-neon-400 transition-colors">
          {t.name}
        </button>
      ))}
    </div>
    <p id="count" class="mt-4 font-mono text-xs text-ink-500"></p>
  </section>

  <section class="mx-auto max-w-7xl px-5 sm:px-8 pb-20">
    <div id="grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => <PostCard {...p} />)}
    </div>
    <p id="empty" class="hidden font-mono text-sm text-ink-500 py-16 text-center">
      Aucun projet dans cette catégorie pour le moment.
    </p>
  </section>
</Base>

<script>
  const grid = document.getElementById('grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('article[data-slug]'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;

  function apply(filter: string) {
    let shown = 0;
    for (const card of cards) {
      const tags = (card.dataset.tags || '').split(' ').filter(Boolean);
      const ok = filter === 'all' || tags.includes(filter);
      card.style.display = ok ? '' : 'none';
      if (ok) shown++;
    }
    count.textContent = `${shown} projet${shown > 1 ? 's' : ''}`;
    empty.classList.toggle('hidden', shown > 0);
    for (const btn of buttons) {
      const active = btn.dataset.filter === filter;
      btn.className = 'filter-btn font-mono text-xs uppercase tracking-wider px-4 py-2 rounded-full border transition-colors ' +
        (active
          ? 'border-neon-500 bg-neon-500/10 text-neon-300'
          : 'border-ink-700 text-ink-300 hover:border-neon-500 hover:text-neon-400');
    }
    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('tag'); else url.searchParams.set('tag', filter);
    history.replaceState(null, '', url);
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => apply(btn.dataset.filter || 'all'));
  }

  const initial = new URLSearchParams(location.search).get('tag');
  apply(initial || 'all');
</script>
