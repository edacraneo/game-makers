---
interface Tag { name: string; slug: string }
import { authorIcon } from '../lib/authors';
interface Props {
  slug: string;
  title: string;
  date: string | null;
  tags: Tag[];
  feature: string | null;
  excerpt: string;
  authors?: string[];
}
const { slug, title, date, tags: rawTags, feature, excerpt, authors = [] } = Astro.props;
const tags = rawTags.filter((t) => t.slug && t.name?.trim());
const d = date ? new Date(date + 'T00:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
const tagSlugs = tags.map((t) => t.slug).join(' ');
---
<article
  class="card-corner group relative flex flex-col overflow-hidden rounded-xl border border-ink-700/70 bg-ink-850 hover:border-neon-500/60 transition-colors duration-300"
  data-tags={tagSlugs}
  data-slug={slug}
>
  <a href={`/projets/${slug}/`} class="block relative aspect-[16/10] overflow-hidden bg-ink-900">
    {feature ? (
      <img
        src={feature}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center font-mono text-ink-600 text-xs">NO IMAGE</div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/85 via-transparent to-transparent"></div>
    {tags.length > 0 && (
      <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 2).map((t) => (
          <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-1 rounded bg-ink-950/80 border border-neon-500/40 text-neon-300 backdrop-blur-sm">
            {t.name}
          </span>
        ))}
      </div>
    )}
  </a>
  <div class="flex flex-col gap-2 p-5 flex-1">
    <div class="flex items-center gap-3 font-mono text-[11px] text-ink-400">
      {d && <time datetime={date || ''}>{d}</time>}
      <span class="text-ink-600">/</span>
      <span class="text-cyanx-400">{slug}</span>
    </div>
    <h3 class="font-display text-lg font-semibold leading-snug text-ink-100 group-hover:text-neon-300 transition-colors">
      <a href={`/projets/${slug}/`} class="hover:underline decoration-neon-500/50 underline-offset-4">{title}</a>
    </h3>
    <p class="text-sm text-ink-400 leading-relaxed line-clamp-2 flex-1">{excerpt}</p>
    <div class="mt-2 flex items-center justify-between gap-2">
      <span class="font-mono text-xs text-neon-500 group-hover:text-neon-400 transition-colors">
        Lire le projet →
      </span>
      {authors.length > 0 && (
        <span class="flex items-center gap-1.5">
          {authors.map((a) => {
            const icon = authorIcon(a);
            return icon ? <img src={icon} alt={a} title={a} class="h-5 w-5 rounded-full border border-ink-600 object-cover" /> : null;
          })}
        </span>
      )}
    </div>
  </div>
</article>
