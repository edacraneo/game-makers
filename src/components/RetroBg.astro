<canvas id="retro-bg" aria-hidden="true"></canvas>
<style>
  #retro-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
</style>
<script>
  (() => {
    const canvas = document.getElementById('retro-bg');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let w = 0, h = 0;
    const dpr = Math.min(devicePixelRatio || 1, 2);

    // Space invader sprite (11x8)
    const INVADER = [
      '..X.....X..',
      '...X...X...',
      '..XXXXXXX..',
      '.XX.XXX.XX.',
      'XXXXXXXXXXX',
      'X.XXXXXXX.X',
      'X.X.....X.X',
      '...XX.XX...',
    ];
    const ALIEN = [
      '.....XX.....',
      '....XXXX....',
      '...XXXXXX...',
      '..XX.XX.XX..',
      '..XXXXXXXX..',
      '....X..X....',
      '...X.XX.X...',
      '..X.X..X.X..',
    ];

    const stars = [];
    const ships = [];

    function resize() {
      w = innerWidth; h = innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      stars.length = 0;
      const n = Math.floor((w * h) / 9000);
      for (let i = 0; i < n; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h,
          s: Math.random() < 0.85 ? 1 : 2,
          v: 6 + Math.random() * 26,
          cyan: Math.random() < 0.3,
          a: 0.12 + Math.random() * 0.35,
        });
      }
      ships.length = 0;
      const sprites = [INVADER, ALIEN, INVADER];
      for (let i = 0; i < 3; i++) {
        const sprite = sprites[i];
        ships.push({
          sprite,
          x: Math.random() * w,
          y: h * (0.15 + 0.6 * Math.random()),
          px: 3,
          v: (8 + Math.random() * 14) * (Math.random() < 0.5 ? 1 : -1),
          bob: Math.random() * Math.PI * 2,
          orange: i === 1,
        });
      }
    }

    function drawSprite(sprite, x, y, px, color) {
      ctx.fillStyle = color;
      for (let r = 0; r < sprite.length; r++) {
        const row = sprite[r];
        for (let c = 0; c < row.length; c++) {
          if (row[c] === 'X') ctx.fillRect(x + c * px, y + r * px, px, px);
        }
      }
    }

    let last = 0;
    function tick(t) {
      const dt = Math.min((t - last) / 1000, 0.05); last = t;
      ctx.clearRect(0, 0, w, h);

      for (const s of stars) {
        s.y += s.v * dt;
        if (s.y > h) { s.y = -2; s.x = Math.random() * w; }
        ctx.globalAlpha = s.a;
        ctx.fillStyle = s.cyan ? '#22d3ee' : '#e6edf3';
        ctx.fillRect(s.x, s.y, s.s, s.s);
      }

      for (const sh of ships) {
        sh.x += sh.v * dt;
        sh.bob += dt;
        const sw = sh.sprite[0].length * sh.px;
        if (sh.v > 0 && sh.x > w + sw) sh.x = -sw;
        if (sh.v < 0 && sh.x < -sw) sh.x = w + sw;
        const y = sh.y + Math.sin(sh.bob) * 8;
        ctx.globalAlpha = 0.07;
        drawSprite(sh.sprite, sh.x, y, sh.px, sh.orange ? '#ff6b1a' : '#22d3ee');
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(tick);
    }

    addEventListener('resize', resize);
    resize();
    requestAnimationFrame(tick);
  })();
</script>
