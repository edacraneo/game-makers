---
interface Tag { name: string; slug: string }
interface Entry {
  slug: string; title: string; date: string | null;
  tags: Tag[]; authors: string[]; feature: string | null;
  html: string; excerpt: string;
}
interface Props { entry: Entry; basePath?: string }
import { authorIcon } from '../lib/authors';
const { entry, basePath = '/projets/' } = Astro.props;
entry.tags = (entry.tags || []).filter((t) => t.slug && t.name?.trim());
const d = entry.date ? new Date(entry.date + 'T00:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
let body = entry.html;
if (entry.feature) {
  const base = (u: string) => u.replace(/^.*\//, '').replace(/-\d+(\.\w+)$/, '$1').toLowerCase().replace(/^mini(\d+)/, 'img$1');
  const m = body.match(/^\s*<figure[^>]*>[\s\S]*?<\/figure>\s*(?:<hr\s*\/?>\s*)?/);
  const src = m?.[0].match(/src="([^"]+)"/)?.[1];
  if (m && src && base(src) === base(entry.feature)) body = body.slice(m[0].length);
}
---
<article class="mx-auto max-w-3xl px-5 sm:px-8 pt-28 pb-16">
  <header class="mb-10">
    <nav class="font-mono text-xs text-ink-500 mb-6">
      <a href="/" class="hover:text-neon-400">Accueil</a>
      <span class="mx-2 text-ink-700">/</span>
      <a href={basePath} class="hover:text-neon-400">{basePath === '/projets/' ? 'Projets' : 'Pages'}</a>
    </nav>
    {entry.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {entry.tags.map((t) => (
          <a href={`/projets/?tag=${t.slug}`} class="font-mono text-[11px] uppercase tracking-wider px-3 py-1 rounded-full border border-neon-500/40 text-neon-300 hover:bg-neon-500/10 transition-colors">
            {t.name}
          </a>
        ))}
      </div>
    )}
    <h1 class="font-display text-3xl sm:text-5xl font-bold leading-tight">{entry.title}</h1>
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-xs text-ink-500">
      {d && <time datetime={entry.date || ''}>{d}</time>}
      {entry.authors.length > 0 && (
        <span class="inline-flex items-center gap-2">
          par {entry.authors.map((a) => {
            const icon = authorIcon(a);
            return (
              <span class="inline-flex items-center gap-1.5">
                {icon && <img src={icon} alt={a} class="h-5 w-5 rounded-full border border-ink-600 object-cover" />}
                {a}
              </span>
            );
          })}
        </span>
      )}
    </div>
  </header>

  {entry.feature && (
    <figure class="mb-10 -mx-2">
      <img src={entry.feature} alt={entry.title} class="w-full rounded-xl border border-ink-700 object-cover max-h-[560px]" />
    </figure>
  )}

  <div class="gm-content" set:html={body} />
</article>

<script>
  const imgs = [...document.querySelectorAll('article > figure img, article .gm-content img:not(.gm-partner-logo)')];
  if (imgs.length) {
    const lb = document.createElement('div');
    lb.className = 'gm-lightbox';
    lb.innerHTML = '<button class="lb-close" aria-label="Fermer">&times;</button>'
      + '<button class="lb-prev" aria-label="Image précédente">&lsaquo;</button>'
      + '<button class="lb-next" aria-label="Image suivante">&rsaquo;</button>'
      + '<img class="lb-img" alt="">'
      + '<div class="lb-count"></div>';
    document.body.appendChild(lb);
    const lbImg = lb.querySelector('.lb-img');
    const count = lb.querySelector('.lb-count');
    const prev = lb.querySelector('.lb-prev');
    const next = lb.querySelector('.lb-next');
    let i = 0, open = false;
    const show = (n) => {
      i = (n + imgs.length) % imgs.length;
      lbImg.src = imgs[i].src;
      lbImg.alt = imgs[i].alt || '';
      const multi = imgs.length > 1;
      count.textContent = multi ? `${i + 1} / ${imgs.length}` : '';
      prev.style.display = multi ? '' : 'none';
      next.style.display = multi ? '' : 'none';
    };
    const openLb = (n) => { open = true; show(n); lb.classList.add('on'); document.body.style.overflow = 'hidden'; };
    const closeLb = () => { open = false; lb.classList.remove('on'); document.body.style.overflow = ''; };
    imgs.forEach((im, n) => im.addEventListener('click', (e) => { e.preventDefault(); openLb(n); }));
    lb.addEventListener('click', (e) => {
      if (e.target.closest('.lb-prev')) show(i - 1);
      else if (e.target.closest('.lb-next')) show(i + 1);
      else closeLb();
    });
    document.addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') closeLb();
      else if (e.key === 'ArrowLeft') show(i - 1);
      else if (e.key === 'ArrowRight') show(i + 1);
    });
  }
</script>
